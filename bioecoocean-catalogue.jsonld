    {
      "@type": "Dataset",
      "name": "Invertebrate eDNA Gotland Summer 2021",
      "description": "This study used environmental DNA (eDNA) metabarcoding of the 18S rRNA gene to characterise invertebrate assemblages from nine water samples (depths < 0.5 m) collected at three coastal sites around Gotland, Sweden, in summer 2021. Sequencing yielded 506,424 high-quality reads representing 42 invertebrate taxa across eight phyla. Arthropoda dominated both taxon richness and sequence abundance, with the copepod Acartia (Acanthacartia) tonsa detected in nearly all samples. For more details see the associated paper Lüskow and Nordlund 2026 https://doi.org/10.1007/s12526-026-01696-4.",
      "url": "https://ipt.obis.org/bioecoocean/resource?r=biodiversity_survey_gotland_summer_2021",
      "additionalType": "Dataset",
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "name": "OBIS",
        "url": "https://ipt.obis.org/bioecoocean/"
      },

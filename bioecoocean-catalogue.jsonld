      "dateCreated": "2024-11-06T08:46:48.647339+00:00",
      "dateModified": "2024-11-06T09:20:42.192837+00:00",
      "datePublished": "2024-11-06",
      "inLanguage": {
        "alternateName": "eng",
        "@type": "Language",

      "name": "The unknown known: coastal brackish-water invertebrate diversity of Gotland, central Baltic Sea",
      "creator": [
        {
          "name": "Lüskow, Florian",
          "givenName": "Florian",
          "familyName": "Lüskow",
          "affiliation": [
            {
              "@type": "Organization",
